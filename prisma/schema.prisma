generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Kullanıcı & Yetkilendirme
// ─────────────────────────────────────────────
enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  password  String
  role      UserRole   @default(CUSTOMER)
  roles     UserRole[] @default([CUSTOMER])

  // Müşteri ilişkileri
  orders    Order[]
  rentals   Rental[]
  cart      Cart?
  reviews   Review[]
  favorites Favorite[]
  dealerFinancial DealerFinancial?

  // Satıcı / Vendor ilişkileri (Vendor'ın listelediği ürünler)
  products  Product[]  @relation("VendorProducts")

  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@index([role])
  @@map("users")
}

// ─────────────────────────────────────────────
// Ürün Yönetimi
// ─────────────────────────────────────────────
enum ProductType {
  SALE
  RENTAL
  BOTH
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?     @db.Text
  images      String[]
  type        ProductType
  salePrice   Decimal?    @map("sale_price") @db.Decimal(10, 2)
  active      Boolean     @default(true)
  isDeleted   Boolean     @default(false) @map("is_deleted")

  // Marka İlişkisi
  brandId String? @map("brand_id")
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  // Ölçü Birimi İlişkisi
  measurementId String?      @map("measurement_id")
  measurement   Measurement? @relation(fields: [measurementId], references: [id], onDelete: SetNull)

  // Ana Kategori ve Alt Kategori İlişkileri
  categoryId    String?   @map("category_id")
  category      Category? @relation("CategoryProducts", fields: [categoryId], references: [id], onDelete: SetNull)

  subCategoryId String?   @map("sub_category_id")
  subCategory   Category? @relation("SubCategoryProducts", fields: [subCategoryId], references: [id], onDelete: SetNull)

  // Satıcı / Mağaza ilişkisi (Marketplace / Multi-Vendor desteği)
  vendorId   String?   @map("vendor_id")
  vendor     User?     @relation("VendorProducts", fields: [vendorId], references: [id], onDelete: SetNull)

  inventory     Inventory?
  rentalPricing RentalPricing?

  cartItems    CartItem[]
  orderItems   OrderItem[]
  rentals      Rental[]
  availability RentalAvailability[]

  // Çoklu Depo Stokları
  stocks Stock[]

  // Vitrinler ve Rezervasyonlar
  showcaseItems      ShowcaseItem[]
  rentalReservations RentalReservation[]

  // Değerlendirmeler & Puanlama
  averageRating Float?    @default(0) @map("average_rating")
  reviewCount   Int       @default(0) @map("review_count")
  reviews       Review[]
  favorites     Favorite[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([type])
  @@index([slug])
  @@index([vendorId])
  @@index([categoryId])
  @@index([subCategoryId])
  @@map("products")
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  isDeleted   Boolean    @default(false) @map("is_deleted")

  // Self-Relation (Kendi Kendine İlişki): Ana ve Alt Kategoriler
  parentId    String?    @map("parent_id")
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[] @relation("CategoryHierarchy")

  // Ürün Eşleştirmeleri
  products    Product[]  @relation("CategoryProducts")
  subProducts Product[]  @relation("SubCategoryProducts")

  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at")

  @@index([parentId])
  @@map("categories")
}

// ─────────────────────────────────────────────
// Stok ve Envanter
// ─────────────────────────────────────────────
model Inventory {
  id String @id @default(cuid())

  productId String  @unique @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Satış stoku
  totalStock    Int @default(0) @map("total_stock")
  reservedStock Int @default(0) @map("reserved_stock")

  // Kiralama için mevcut birim sayısı
  rentalQuantity Int @default(0) @map("rental_quantity")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("inventories")
}

// ─────────────────────────────────────────────
// Kiralama Fiyatlandırma
// ─────────────────────────────────────────────
model RentalPricing {
  id String @id @default(cuid())

  productId String  @unique @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  dailyPrice    Decimal  @map("daily_price") @db.Decimal(10, 2)
  weeklyPrice   Decimal? @map("weekly_price") @db.Decimal(10, 2)
  monthlyPrice  Decimal? @map("monthly_price") @db.Decimal(10, 2)
  depositAmount Decimal  @default(0) @map("deposit_amount") @db.Decimal(10, 2)
  minDays       Int      @default(1) @map("min_days")
  maxDays       Int      @default(90) @map("max_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("rental_pricings")
}

// ─────────────────────────────────────────────
// Kiralama Müsaitlik Kilitleme
// (Louez / Sharetribe tarzı date-range blocking)
// ─────────────────────────────────────────────
model RentalAvailability {
  id String @id @default(cuid())

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")

  rentalId String? @map("rental_id")
  rental   Rental? @relation(fields: [rentalId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId, startDate, endDate])
  @@map("rental_availabilities")
}

// ─────────────────────────────────────────────
// Sepet (Hibrit: Satış + Kiralama)
// ─────────────────────────────────────────────
model Cart {
  id String @id @default(cuid())

  userId    String? @unique @map("user_id")
  user      User?   @relation(fields: [userId], references: [id])
  sessionId String? @unique @map("session_id")

  items CartItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("carts")
}

enum CartItemType {
  SALE
  RENTAL
}

model CartItem {
  id String @id @default(cuid())

  cartId String @map("cart_id")
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])

  type     CartItemType
  quantity Int          @default(1)

  // Kiralama kalemleri için tarih aralığı
  rentalStart DateTime? @map("rental_start")
  rentalEnd   DateTime? @map("rental_end")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cart_items")
}

// ─────────────────────────────────────────────
// Sipariş
// ─────────────────────────────────────────────
enum OrderStatus {
  PENDING
  PAID
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  FAILED
  REFUNDED
}

model Order {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  items       OrderItem[]
  payments    Payment[]
  totalAmount Decimal     @map("total_amount") @db.Decimal(10, 2)
  status      OrderStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("orders")
}

enum OrderItemType {
  SALE
  RENTAL
}

model OrderItem {
  id String @id @default(cuid())

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])

  type       OrderItemType
  quantity   Int           @default(1)
  unitPrice  Decimal       @map("unit_price") @db.Decimal(10, 2)
  totalPrice Decimal       @map("total_price") @db.Decimal(10, 2)

  // Snapshot alanları (Sipariş anındaki ürün adı, görseli ve fiyatı - ürün sonradan değişse bile sipariş tutarlılığı korunur)
  productName     String?  @map("product_name")
  productImage    String?  @map("product_image")
  priceAtPurchase Decimal? @map("price_at_purchase") @db.Decimal(10, 2)

  // Kiralama referansı
  rentalId String? @unique @map("rental_id")
  rental   Rental? @relation(fields: [rentalId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@map("order_items")
}

// ─────────────────────────────────────────────
// Kiralama Kayıtları
// ─────────────────────────────────────────────
enum RentalStatus {
  RESERVED
  ACTIVE
  RETURN_REQUESTED
  RETURNED
  OVERDUE
  CANCELLED
}

model Rental {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])

  orderItem OrderItem?
  escrow    EscrowTransaction?

  startDate     DateTime @map("start_date")
  endDate       DateTime @map("end_date")
  dailyRate     Decimal  @map("daily_rate") @db.Decimal(10, 2)
  totalPrice    Decimal  @map("total_price") @db.Decimal(10, 2)
  depositAmount Decimal  @default(0) @map("deposit_amount") @db.Decimal(10, 2)

  status RentalStatus @default(RESERVED)

  availability RentalAvailability[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("rentals")
}

// ─────────────────────────────────────────────
// Ödeme ve Depozito / Escrow
// ─────────────────────────────────────────────
enum PaymentProvider {
  STRIPE
  IYZICO
  SANDBOX
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum EscrowStatus {
  HELD
  RELEASED
  CAPTURED
  FAILED
}

model Payment {
  id            String          @id @default(cuid())
  orderId       String          @map("order_id")
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Decimal         @db.Decimal(10, 2)
  currency      String          @default("TRY")
  provider      PaymentProvider @default(STRIPE)
  status        PaymentStatus   @default(PENDING)
  transactionId String?         @map("transaction_id")
  cardLast4     String?         @map("card_last4")
  cardBrand     String?         @map("card_brand")
  errorMessage  String?         @map("error_message")

  escrows       EscrowTransaction[]

  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@map("payments")
}

model EscrowTransaction {
  id            String          @id @default(cuid())
  paymentId     String?         @map("payment_id")
  payment       Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  rentalId      String          @unique @map("rental_id")
  rental        Rental          @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  depositAmount Decimal         @map("deposit_amount") @db.Decimal(10, 2)
  holdId        String?         @map("hold_id")
  status        EscrowStatus    @default(HELD)
  releasedAt    DateTime?       @map("released_at")
  releaseTxId   String?         @map("release_tx_id")

  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@map("escrow_transactions")
}

// ─────────────────────────────────────────────
// Ürün Değerlendirme & Yorum (Reviews & Ratings)
// ─────────────────────────────────────────────
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id             String       @id @default(cuid())
  rating         Int          // 1 ile 5 arasında tamsayı
  comment        String       @db.Text
  status         ReviewStatus @default(PENDING)

  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId      String       @map("product_id")
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Doğrulanmış müşteri (satın almış veya kiralamış)
  isVerified     Boolean      @default(false) @map("is_verified")

  // Moderasyon notu
  moderationNote String?      @map("moderation_note")

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at")

  @@unique([userId, productId])
  @@index([productId, status])
  @@index([userId])
  @@index([status])
  @@map("reviews")
}

// ─────────────────────────────────────────────
// Favoriler & İstek Listesi (Favorites / Wishlist)
// ─────────────────────────────────────────────
model Favorite {
  id        String   @id @default(cuid())

  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("favorites")
}

// ─────────────────────────────────────────────
// ADIM 1 & 2: Marka ve Ölçü Birimi Modelleri
// ─────────────────────────────────────────────
model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  isDeleted Boolean   @default(false) @map("is_deleted")
  products  Product[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("brands")
}

model Measurement {
  id        String    @id @default(cuid())
  name      String
  code      String    @unique
  products  Product[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("measurements")
}

// ─────────────────────────────────────────────
// ADIM 3: İndirim ve Kupon Motoru (Coupon)
// ─────────────────────────────────────────────
enum DiscountType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id              String       @id @default(cuid())
  code            String       @unique
  discountType    DiscountType @default(PERCENTAGE) @map("discount_type")
  discountValue   Decimal      @map("discount_value") @db.Decimal(10, 2)
  minBasketAmount Decimal      @default(0) @map("min_basket_amount") @db.Decimal(10, 2)
  expiresAt       DateTime?    @map("expires_at")
  isActive        Boolean      @default(true) @map("is_active")

  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at")

  @@map("coupons")
}

// ─────────────────────────────────────────────
// ADIM 4: Admin Kontrollü Dinamik Ana Sayfa Vitrinleri
// ─────────────────────────────────────────────
model Slider {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String   @map("image_url")
  linkUrl   String?  @map("link_url")
  order     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("sliders")
}

model InstagramPost {
  id        String   @id @default(cuid())
  postUrl   String   @map("post_url")
  imageUrl  String   @map("image_url")
  caption   String?
  order     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("instagram_posts")
}

enum ShowcaseType {
  TREND
  BEST_SELLER
  NEW_ARRIVALS
  CUSTOM
}

model ShowcaseItem {
  id        String       @id @default(cuid())
  type      ShowcaseType
  title     String?
  productId String       @map("product_id")
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  order     Int          @default(0)

  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at")

  @@index([type])
  @@map("showcase_items")
}

// ─────────────────────────────────────────────
// ADIM 5: Çoklu Depo ve Şube Yönetimi
// ─────────────────────────────────────────────
model Warehouse {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  isDefault Boolean  @default(false) @map("is_default")
  address   String?
  stocks    Stock[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("warehouses")
}

model Stock {
  id          String    @id @default(cuid())
  productId   String    @map("product_id")
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String    @map("warehouse_id")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity    Int       @default(0)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@unique([productId, warehouseId])
  @@map("stocks")
}

// ─────────────────────────────────────────────
// ADIM 6: B2B Bayi Finansal Altyapısı
// ─────────────────────────────────────────────
model DealerFinancial {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditLimit    Decimal  @default(0) @map("credit_limit") @db.Decimal(12, 2)
  currentBalance Decimal  @default(0) @map("current_balance") @db.Decimal(12, 2)
  discountRate   Decimal  @default(0) @map("discount_rate") @db.Decimal(5, 2)

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("dealer_financials")
}

// ─────────────────────────────────────────────
// ADIM 7: Gelişmiş Kiralama Çakışma Motoru
// ─────────────────────────────────────────────
enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model RentalReservation {
  id        String            @id @default(cuid())
  productId String            @map("product_id")
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  startDate DateTime          @map("start_date")
  endDate   DateTime          @map("end_date")
  status    ReservationStatus @default(CONFIRMED)
  rentalId  String?           @map("rental_id")
  userId    String?           @map("user_id")

  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at")

  @@index([productId, startDate, endDate])
  @@map("rental_reservations")
}
